# Local development. Railway injects PORT automatically.
PORT=3000
NODE_ENV=development

# In production secure cookies are enabled automatically when NODE_ENV=production.
# Set explicitly only if you need to override the automatic behavior.
# COOKIE_SECURE=false

JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# Bootstrap admin. The first start creates/upgrades this account to admin.
ADMIN_USERNAME=darkadmin
ADMIN_PASSWORD=change_this_admin_password

# Public server information. Admin can later override these values in CMS Settings.
SITE_SERVER_IP=darkgamespro.falix.pro
MINECRAFT_VERSION=1.21.1
DEVELOPER_DISCORD_HANDLE=@developer
DEVELOPER_DISCORD_URL=

# Discord OAuth. Leave empty until you create a Discord Developer Application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local: http://localhost:3000/auth/discord/callback
# Railway: https://YOUR-DOMAIN.up.railway.app/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Storage ---------------------------------------------------------------------
# Local default is ./data. On Railway mount one Volume to /app/data and set:
# DATA_DIR=/app/data
DATA_DIR=./data

# Optional advanced overrides. Normally leave empty.
# DB_PATH=/app/data/dark-games.db
# UPLOADS_DIR=/app/data/uploads

# Optional locally. Railway is detected automatically and trust proxy is enabled.
TRUST_PROXY=false
