.env

# Persistent application data. Keep only directory placeholders in Git.
data/*.db
data/*.db-shm
data/*.db-wal
data/uploads/*
!data/.gitkeep
!data/uploads/.gitkeep

# Legacy v5.2 upload location (migrated automatically to data/uploads).
public/uploads/*
!public/uploads/.gitkeep

npm-debug.log*
.DS_Store
