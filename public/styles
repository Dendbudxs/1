/* v5.6.0 — seamless backdrop, aurora veil transition, lore search fix ------ */

/* Keep the scenic layer inside the normal stacking context. Negative z-index
   could fall behind the body/html background at the bottom of short pages,
   which looked like a leftover violet strip. */
html,
body {
  background: #070b10 !important;
}
.page-texture {
  z-index: 0 !important;
  background:
    linear-gradient(180deg, rgba(5,9,14,.36) 0%, rgba(5,9,14,.46) 44%, rgba(5,9,14,.63) 100%),
