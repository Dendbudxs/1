/* Current Violet/Lime portal theme. Historical experiments were removed. */
/* v5.4.9 — Cyber Neon + cinematic home background -------------------------- */
:root {
  --neon-cyan: #57e8ff;
  --neon-violet: #8f7cff;
  --neon-pink: #ff5ca8;
  --neon-lime: #72ffb3;
