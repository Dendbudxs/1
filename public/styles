/* News/banner editorial components introduced with the CMS variants. */
/* v5.4.3 experimental editorial styles ------------------------------------- */
.banner-item {
  isolation: isolate;
  transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease, background .28s ease;
  background: linear-gradient(135deg, rgba(17, 22, 28, .94), rgba(12, 15, 19, .86));
}
.banner-item::before {
  content: "";
  position: absolute;
  inset: 1px;
  border-radius: calc(var(--radius) - 1px);
  background: linear-gradient(140deg, rgba(255,255,255,.05), rgba(255,255,255,0) 34%, rgba(255,255,255,.02) 100%);
  pointer-events: none;
  z-index: 0;
}
.banner-item::after {
  background: linear-gradient(90deg, rgba(7,9,11,.93), rgba(7,9,11,.68) 46%, rgba(7,9,11,.36) 70%, rgba(7,9,11,.62));
}
.banner-item:hover { transform: translateY(-3px); border-color: rgba(255,255,255,.14); box-shadow: 0 28px 70px rgba(0,0,0,.42); }
.banner-item img { opacity: .48; filter: saturate(.84) contrast(1.02) brightness(.88); }
.banner-copy { display: grid; gap: 12px; }
.banner-meta { position: relative; z-index: 1; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; color: #c8ced2; }
.banner-kicker, .article-meta #newsDetailVariantTag { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.10); background: rgba(255,255,255,.04); color: #e8ebed; font-size: 10px; font-weight: 650; letter-spacing: .13em; text-transform: uppercase; }
.banner-kicker::before, .article-meta #newsDetailVariantTag::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px var(--accent-soft); }
.banner-index { color: var(--muted); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
.banner-copy h3 { margin: 0; max-width: 12ch; font-family: var(--editorial); font-size: clamp(28px, 3.3vw, 46px); line-height: 1.04; letter-spacing: -.03em; font-weight: 600; }
.banner-copy p { max-width: 58ch; color: #bec5ca; font-size: 15px; line-height: 1.75; }
.banner-actions { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
.banner-link { display: inline-flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid rgba(255,255,255,.10); border-radius: 999px; background: rgba(255,255,255,.04); color: #eef1f2; font-size: 12px; letter-spacing: .05em; text-transform: uppercase; }
.banner-link::after { content: "→"; transform: translateY(-1px); }
.banner-link:hover { border-color: var(--accent-focus); background: rgba(255,255,255,.06); }
.banner-accent-note { color: var(--muted); font-size: 12px; }
.banner-item[data-variant="spotlight"] { background: linear-gradient(135deg, rgba(19, 24, 30, .96), rgba(11, 14, 17, .90)); }
.banner-item[data-variant="spotlight"]::before { background: radial-gradient(circle at 78% 22%, rgba(122,152,163,.20), transparent 28%), linear-gradient(140deg, rgba(255,255,255,.06), rgba(255,255,255,0) 34%, rgba(255,255,255,.02)); }
.banner-item[data-variant="chronicle"] { background: linear-gradient(135deg, rgba(22, 20, 18, .96), rgba(12, 10, 10, .92)); }
.banner-item[data-variant="chronicle"]::before { background: radial-gradient(circle at 80% 25%, rgba(173,126,86,.18), transparent 26%), linear-gradient(140deg, rgba(255,255,255,.05), rgba(255,255,255,0) 38%, rgba(255,244,221,.025)); }
.banner-item[data-variant="signal"] { background: linear-gradient(135deg, rgba(13, 22, 20, .96), rgba(9, 14, 13, .92)); }
.banner-item[data-variant="signal"]::before { background: radial-gradient(circle at 82% 20%, rgba(105,156,136,.18), transparent 26%), linear-gradient(140deg, rgba(255,255,255,.05), rgba(255,255,255,0) 38%, rgba(211,255,243,.03)); }
.banner-item[data-variant="update"] { background: linear-gradient(135deg, rgba(17, 19, 28, .96), rgba(11, 12, 19, .92)); }
.banner-item[data-variant="update"]::before { background: radial-gradient(circle at 82% 20%, rgba(132,126,193,.20), transparent 28%), linear-gradient(140deg, rgba(255,255,255,.05), rgba(255,255,255,0) 36%, rgba(223,221,255,.03)); }

.home-news-heading { margin-bottom: 18px; }
.news-list { display: grid; gap: 12px; border-top: 1px solid var(--line); }
.news-item {
  position: relative;
  grid-template-columns: 140px minmax(0,1fr) 26px;
  gap: 24px;
  padding: 24px 14px 24px 0;
  border-bottom: 1px solid var(--line);
  border-radius: 18px;
  transition: transform .24s ease, background .24s ease, border-color .24s ease, padding .24s ease;
}
.news-item.has-image { grid-template-columns: 130px minmax(0,1fr) 192px 26px; }
.news-item::before { content: ""; position: absolute; left: 0; top: 18px; bottom: 18px; width: 1px; background: rgba(255,255,255,.08); }
.news-item:hover { transform: translateY(-2px); background: linear-gradient(90deg, rgba(255,255,255,.026), rgba(255,255,255,.012)); border-color: rgba(255,255,255,.12); padding-left: 12px; padding-right: 14px; }
.news-item:hover::before { background: var(--accent); }
.news-date-block { display: grid; gap: 10px; align-content: start; padding-left: 18px; }
.news-date-block time { color: #a7b0b7; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
.news-date-block small { color: var(--muted-2); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }
.news-copy { min-width: 0; display: grid; gap: 10px; }
.news-topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.news-pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,.08); font-size: 10px; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; background: rgba(255,255,255,.035); color: #dfe4e8; }
.news-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .7; }
.news-read { color: var(--muted-2); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
.news-item h3 { margin: 0; font-family: var(--editorial); font-size: clamp(22px, 2vw, 31px); line-height: 1.08; font-weight: 600; letter-spacing: -.025em; }
.news-item p { margin: 0; max-width: 62ch; color: #afb6bc; font-size: 15px; line-height: 1.72; }
.news-thumb { align-self: stretch; overflow: hidden; min-height: 132px; border-radius: 16px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.025); }
.news-thumb img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.88) brightness(.90); transition: transform .32s ease; }
.news-item:hover .news-thumb img { transform: scale(1.03); }
.news-arrow { align-self: center; color: #d2d7da; font-size: 19px; transform: translateY(0); }
.news-item:hover .news-arrow { transform: translate(4px, 0); }
.news-item[data-variant="chronicle"] .news-pill { color: #e5d5bb; background: rgba(181,136,94,.08); }
.news-item[data-variant="spotlight"] .news-pill { color: #dce8ef; background: rgba(123,152,163,.10); }
.news-item[data-variant="update"] .news-pill { color: #d9d6f1; background: rgba(123,121,180,.11); }

.article-page { max-width: 980px; }
.article-page[data-variant] .article-meta { gap: 10px; align-items: center; }
.article-page h1 { margin-top: 22px; font-family: var(--editorial); font-size: clamp(36px, 5vw, 58px); line-height: 1.02; letter-spacing: -.04em; font-weight: 600; max-width: 13ch; }
.article-page[data-variant="chronicle"] h1 { max-width: 14ch; }
.article-lead { max-width: 760px; margin-bottom: 26px; color: #b5bcc2; font-size: 19px; line-height: 1.75; }
.article-cover { border-radius: 20px; border-color: rgba(255,255,255,.08); box-shadow: 0 20px 60px rgba(0,0,0,.35); }
.article-body { max-width: 760px; color: #cbd0d4; font-size: 17px; line-height: 1.95; }
.article-body::first-letter { margin-right: 2px; font-family: var(--editorial); font-size: 2.6em; line-height: .84; float: left; color: #f0f3f5; }
.article-page[data-variant="chronicle"] #newsDetailVariantTag::before { background: #c79e74; box-shadow: 0 0 0 5px rgba(199,158,116,.14); }
.article-page[data-variant="spotlight"] #newsDetailVariantTag::before { background: #7b98a3; box-shadow: 0 0 0 5px rgba(123,152,163,.16); }
.article-page[data-variant="update"] #newsDetailVariantTag::before { background: #8f8ec9; box-shadow: 0 0 0 5px rgba(143,142,201,.15); }

@media (max-width: 980px) {
  .news-item.has-image { grid-template-columns: 120px minmax(0,1fr) 160px 24px; }
  .banner-copy h3 { max-width: 14ch; }
}
@media (max-width: 760px) {
  .banner-copy h3 { font-size: 30px; }
  .banner-actions { gap: 10px; }
  .banner-accent-note { font-size: 11px; }
  .news-item, .news-item.has-image { grid-template-columns: 1fr 22px; padding: 18px 8px 18px 0; }
  .news-date-block { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; padding-left: 14px; }
  .news-copy { grid-column: 1 / 2; padding-left: 14px; }
  .news-thumb { grid-column: 1 / 2; margin-left: 14px; min-height: 180px; }
  .news-arrow { grid-column: 2 / 3; grid-row: 2 / span 2; align-self: start; margin-top: 8px; }
  .article-page h1 { max-width: none; }
  .article-body::first-letter { font-size: 2.1em; }
}
@media (max-width: 520px) {
  .banner-item, [data-page="home"] .banner-item { padding: 22px; min-height: 290px; }
  .banner-meta { gap: 8px; }
  .banner-copy p { font-size: 14px; }
  .news-topline { align-items: flex-start; }
  .news-item h3 { font-size: 24px; }
  .news-item p { font-size: 14px; }
  .article-lead { font-size: 17px; }
  .article-body { font-size: 16px; }
}


/* DARK base layout and components. */
:root {
  color-scheme: dark;
  --bg: #0a0c0f;
  --bg-2: #0e1115;
  --bg-top: #0b0d10;
  --bg-bottom: #090b0e;
  --ambient-a: rgba(87, 102, 113, .10);
  --ambient-b: rgba(68, 81, 91, .07);
  --surface-rgb: 20 24 29;
  --surface-opacity: .74;
  --surface: rgb(var(--surface-rgb) / var(--surface-opacity));
  --surface-strong: rgb(var(--surface-rgb) / .90);
  --surface-soft: rgba(255, 255, 255, .025);
  --line: rgba(255, 255, 255, .085);
  --line-strong: rgba(255, 255, 255, .14);
  --text: #f2f3f2;
  --muted: #8d969f;
  --muted-2: #646d75;
  --accent: #7b98a3;
  --accent-soft: rgba(123, 152, 163, .14);
  --accent-focus: rgba(123, 152, 163, .50);
  --accent-switch: rgba(123, 152, 163, .20);
  --accent-switch-line: rgba(123, 152, 163, .36);
  --good: #80a58b;
  --warn: #b39b6e;
  --bad: #a77a7a;
  --radius: 18px;
  --radius-sm: 10px;
  --radius-lg: 20px;
  --acrylic-blur: 22px;
  --texture-opacity: .22;
  --ui-font-size: 15px;
  --shadow: 0 24px 70px rgba(0, 0, 0, .36);
  --font: "Segoe UI Variable Text", "Segoe UI", Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  --display: "Segoe UI Variable Display", "Segoe UI", Inter, system-ui, sans-serif;
  --book: Georgia, "Times New Roman", serif;
  --editorial: "Palatino Linotype", "Book Antiqua", Georgia, "Times New Roman", serif;
}

html[data-theme="obsidian"] { --bg:#070809; --bg-2:#0b0c0e; --bg-top:#08090b; --bg-bottom:#050607; --ambient-a:rgba(92,98,105,.055); --ambient-b:rgba(80,86,92,.035); --surface-rgb:13 15 18; --line:rgba(255,255,255,.075); --muted:#8c9297; }
html[data-theme="steel"] { --bg:#0a0e12; --bg-2:#10161c; --bg-top:#0c1116; --bg-bottom:#080b0f; --ambient-a:rgba(88,116,139,.13); --ambient-b:rgba(67,88,105,.09); --surface-rgb:18 25 31; --muted:#93a0aa; --muted-2:#687681; }
html[data-theme="warm"] { --bg:#0e0c0b; --bg-2:#15110f; --bg-top:#100d0c; --bg-bottom:#0a0807; --ambient-a:rgba(126,102,83,.11); --ambient-b:rgba(96,77,66,.07); --surface-rgb:28 23 20; --muted:#a0968f; --muted-2:#746a64; }
html[data-density="compact"] { --ui-font-size:14px; }
html[data-density="relaxed"] { --ui-font-size:16px; }
html[data-corners="sharp"] { --radius:10px; --radius-sm:7px; --radius-lg:12px; }
html[data-corners="round"] { --radius:26px; --radius-sm:15px; --radius-lg:28px; }
html[data-font="clean"] { --font: Inter, Arial, system-ui, sans-serif; --display: Inter, Arial, system-ui, sans-serif; }
html[data-font="technical"] { --font: Bahnschrift, "Arial Narrow", Arial, sans-serif; --display: Bahnschrift, "Arial Narrow", Arial, sans-serif; }

* { box-sizing: border-box; }
html { scroll-behavior: smooth; background: var(--bg); }
body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% -10%, var(--ambient-a), transparent 30%),
    radial-gradient(circle at 90% 10%, var(--ambient-b), transparent 28%),
    linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 100%);
  color: var(--text);
  font-family: var(--font);
  font-size: var(--ui-font-size);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
body.menu-open, body.dialog-open { overflow: hidden; }
button, input, textarea, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button { border: 0; }
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
[hidden] { display: none !important; }

.page-texture {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: var(--texture-opacity);
  background-image:
    linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.009) 1px, transparent 1px);
  background-size: 4px 4px, 5px 5px;
  mask-image: linear-gradient(to bottom, rgba(0,0,0,.75), rgba(0,0,0,.25));
}

.content-width { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
.kicker {
  margin: 0;
  color: var(--accent);
  font-size: 11px;
  line-height: 1;
  font-weight: 750;
  letter-spacing: .14em;
  text-transform: uppercase;
}


/* Header ------------------------------------------------------------------ */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 14px 18px 0;
  pointer-events: none;
}
.header-shell {
  width: min(1260px, 100%);
  height: 64px;
  margin: 0 auto;
  padding: 0 10px 0 12px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 26px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  backdrop-filter: blur(var(--acrylic-blur)) saturate(125%);
  -webkit-backdrop-filter: blur(var(--acrylic-blur)) saturate(125%);
  box-shadow: 0 14px 44px rgba(0,0,0,.24);
  pointer-events: auto;
}
.brand { display: inline-flex; align-items: center; gap: 10px; min-width: max-content; }
.brand-mark {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,.035);
  color: #fff;
  font-family: var(--display);
  font-weight: 820;
  letter-spacing: -.04em;
}
.brand-name { font-family: var(--display); font-weight: 780; letter-spacing: .12em; font-size: 13px; }
.desktop-nav { display: flex; height: 100%; align-items: center; gap: 6px; }
.desktop-nav a {
  position: relative;
  padding: 22px 15px 21px;
  color: #9ea6ad;
  font-size: 13px;
  font-weight: 600;
  transition: color .22s ease;
}
.desktop-nav a::after {
  content: "";
  position: absolute;
  left: 15px;
  right: 15px;
  bottom: 12px;
  height: 1px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform .24s ease;
}
.desktop-nav a:hover, .desktop-nav a.active { color: #fff; }
.desktop-nav a.active::after { transform: scaleX(1); }
.header-actions { display: flex; align-items: center; gap: 8px; }
.server-mini, .account-chip, .menu-button {
  height: 42px;
  color: var(--text);
  background: transparent;
  cursor: pointer;
}
.server-mini {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  color: var(--muted);
  font-size: 12px;
}
.status-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 999px;
  background: var(--muted-2);
  box-shadow: 0 0 0 3px rgba(255,255,255,.025);
}
.status-dot.online { background: var(--good); box-shadow: 0 0 0 4px rgba(128,165,139,.08); }
.status-dot.maintenance { background: var(--warn); box-shadow: 0 0 0 4px rgba(179,155,110,.08); }
.status-dot.offline { background: var(--bad); box-shadow: 0 0 0 4px rgba(167,122,122,.07); }
.account-chip {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px 0 7px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,.025);
  font-size: 12px;
  font-weight: 650;
  transition: background .2s ease, border-color .2s ease;
}
.account-chip:hover { background: rgba(255,255,255,.055); border-color: var(--line-strong); }
.avatar {
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 50%;
  background: linear-gradient(145deg, #242b31, #111519);
  color: #dce3e6;
  font-weight: 760;
}
.avatar img { width: 100%; height: 100%; object-fit: cover; }
.avatar-small { width: 28px; height: 28px; font-size: 10px; }
.avatar-large { width: 78px; height: 78px; font-size: 23px; }
.menu-button { width: 42px; display: none; place-content: center; gap: 4px; padding: 0; }
.menu-button span { width: 18px; height: 1px; display: block; background: #bdc3c8; transition: .2s ease; }

/* Mobile drawer ----------------------------------------------------------- */
.mobile-menu-backdrop { position: fixed; inset: 0; z-index: 149; background: rgba(0,0,0,.54); backdrop-filter: blur(2px); }
.mobile-menu {
  position: fixed;
  z-index: 150;
  top: 0;
  right: 0;
  width: min(86vw, 360px);
  height: 100dvh;
  padding: max(22px, env(safe-area-inset-top)) 22px max(22px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: rgb(var(--surface-rgb) / .92);
  backdrop-filter: blur(var(--acrylic-blur));
  -webkit-backdrop-filter: blur(var(--acrylic-blur));
  border-left: 1px solid var(--line);
  box-shadow: -24px 0 70px rgba(0,0,0,.42);
  transform: translateX(102%);
  transition: transform .28s cubic-bezier(.2,.7,.2,1);
}
.mobile-menu.open { transform: translateX(0); }
.mobile-menu-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
.mobile-menu-head > span { font-weight: 780; letter-spacing: .16em; }
.mobile-menu-head button { width: 38px; height: 38px; border-radius: 10px; background: transparent; color: var(--muted); font-size: 25px; cursor: pointer; }
.mobile-menu nav { display: grid; padding: 18px 0; }
.mobile-menu nav a { padding: 14px 4px; border-bottom: 1px solid rgba(255,255,255,.045); color: #d8dcdf; font-size: 17px; }
.mobile-menu nav a.active { color: #fff; }
.mobile-menu-foot { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); display: grid; gap: 4px; color: var(--muted); font-size: 12px; }
.mobile-menu-foot small { color: var(--muted-2); }

/* Page transitions -------------------------------------------------------- */
.app-main { min-height: calc(100vh - 130px); }
.page { display: none; padding: 76px 0 88px; }
.page.active { display: block; animation: pageIn .42s cubic-bezier(.2,.7,.2,1) both; }
html.motion-off .page.active { animation: none; }
@keyframes pageIn {
  from { opacity: 0; transform: translateY(6px); filter: blur(3px); }
  to { opacity: 1; transform: none; filter: blur(0); }
}
::view-transition-old(root) { animation: fadeOut .18s ease both; }
::view-transition-new(root) { animation: fadeIn .35s ease both; }
@keyframes fadeOut { to { opacity: 0; } }
@keyframes fadeIn { from { opacity: 0; } }


/* Current shared scenic background, header behavior, transitions, and stability fixes. */
/* v5.5.6 — Scenic global background + directional transitions ------------- */

/* One shared Minecraft background for the entire portal, not only Home. */
html {
  background: #070b10;
}
body {
  position: relative;
  isolation: isolate;
  background: #070b10;
}
.page-texture {
  inset: 0;
  z-index: -3;
  opacity: 1;
  mask-image: none;
  -webkit-mask-image: none;
  background:
    linear-gradient(180deg, rgba(5, 9, 14, .38) 0%, rgba(5, 9, 14, .48) 38%, rgba(5, 9, 14, .66) 100%),
    radial-gradient(circle at 18% 18%, rgba(143, 109, 255, .10), transparent 28%),
    radial-gradient(circle at 82% 18%, rgba(140, 255, 59, .055), transparent 24%),
    url('/home-bg.png') center center / cover no-repeat fixed;
}
.page-texture::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.008) 1px, transparent 1px);
  background-size: 5px 5px, 5px 5px;
  opacity: .15;
}

/* Home used its own fixed picture before. The global layer now owns it. */
.page[data-page="home"]::before,
.page[data-page="home"]::after {
