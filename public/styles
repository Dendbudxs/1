  content: "";
  position: absolute;
  left: 50%;
  bottom: -1px;
  width: min(220px, 36vw);
  height: 1px;
  transform: translateX(-50%);
  background: linear-gradient(90deg, transparent, rgba(140,255,59,.24), transparent);
