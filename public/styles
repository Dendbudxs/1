/* HOME BACKGROUND: use the supplied Minecraft render as the real stage. */
.page[data-page="home"] {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
}
.page[data-page="home"]::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  pointer-events: none;
  background-image: url('/home-bg.png');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  filter: saturate(1.06) contrast(1.02) brightness(.74);
  transform: scale(1.015);
}
.page[data-page="home"]::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background:
    radial-gradient(circle at 18% 18%, rgba(87,232,255,.15), transparent 28%),
    radial-gradient(circle at 82% 18%, rgba(255,92,168,.11), transparent 26%),
    linear-gradient(180deg, rgba(4,7,14,.28) 0%, rgba(5,8,16,.54) 42%, rgba(4,7,14,.78) 100%);
