.page[data-page="home"] .home-stage-nav,
.page[data-page="home"] .home-intro,
.page[data-page="home"] .stage-heading,
.page[data-page="home"] .section-heading,
.page[data-page="home"] .stage-footer,
.page[data-page="home"] .banner-strip,
.page[data-page="home"] .news-list,
.page[data-page="home"] .news-more-wrap,
.page[data-page="home"] .banner-empty {
