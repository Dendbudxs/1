  background: transparent !important;
}
.site-footer {
  isolation: isolate;
}
.footer-line {
  background: transparent !important;
}

/* Header server state is information, not navigation. */
.server-mini {
  cursor: default !important;
  user-select: none;
}
.server-mini:hover {
  transform: none !important;
  background: transparent !important;
  box-shadow: none !important;
}

/* New route transition: a very light aurora/glass veil sweeps over a completely
   static scenic background. No blur, backdrop-filter or full-page scale is animated. */
.route-veil {
  position: fixed;
  inset: 0;
  z-index: 96;
  pointer-events: none;
  opacity: 0;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(4,9,14,.08), rgba(4,9,14,.16));
  will-change: opacity;
}
.route-veil > span {
  position: absolute;
  top: -10%;
  bottom: -10%;
  left: 50%;
  width: min(52vw, 760px);
  transform: translate3d(-125vw,0,0);
  opacity: 0;
  background:
    linear-gradient(90deg,
      transparent 0%,
      rgba(115,223,255,.035) 18%,
      rgba(115,223,255,.12) 43%,
      rgba(140,255,59,.075) 58%,
      rgba(196,186,255,.06) 72%,
      transparent 100%);
  border-left: 1px solid rgba(160,229,238,.06);
  border-right: 1px solid rgba(160,229,238,.05);
  will-change: transform, opacity;
}
html.route-switching {
  scroll-behavior: auto;
}
html.route-switching .site-footer {
  pointer-events: none;
}

/* Do not let old per-page fills peek through during route changes. */
