/* Header gently leaves the viewport while scrolling down and returns as soon
   as the user scrolls upward. Sticky layout remains intact, so content never jumps. */
.site-header {
  transform: translate3d(0,0,0);
  opacity: 1;
  transition:
    transform 520ms cubic-bezier(.16,1,.3,1),
    opacity 360ms ease;
  will-change: transform, opacity;
}
.site-header.header-hidden {
  transform: translate3d(0, calc(-100% - 18px), 0);
  opacity: .06;
  pointer-events: none;
}
.site-header.header-hidden .header-shell {
  pointer-events: none;
}

/* A tiny edge marker makes the reveal feel intentional rather than abrupt. */
